{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arclight",
  "version": "0.1.3",
  "identifier": "dev.dnetlab.arclight",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arclight",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0D1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "D-Net Lab",
    "copyright": "Copyright (c) 2026 D-Net Lab",
    "shortDescription": "Explorer, editor and terminal in one window",
    "longDescription": "Arclight is a tiled workspace that replaces your file explorer, editor and terminal with a single lightweight program. Real ConPTY terminals, a CodeMirror editor, and an optional local control API for driving the workspace programmatically. From D-Net Lab.",
    "category": "DeveloperTool",
    "homepage": "https://github.com/DezMetal/Arclight",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "D-Net Lab"
      }
    }
  }
}
