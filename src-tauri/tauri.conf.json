{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arclight",
  "version": "0.1.1",
  "identifier": "dev.dnetlab.arclight",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arclight",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0D1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "D-Net Lab",
    "copyright": "D-Net Lab",
    "shortDescription": "Arclight workspace",
    "longDescription": "Arclight — a tiled explorer, editor and terminal workspace from D-Net Lab."
  }
}
